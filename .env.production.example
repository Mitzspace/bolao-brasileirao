# Render Free + Neon Free. Não adicionar credenciais ao Git.
APP_ENV=production
FLASK_DEBUG=0
SECRET_KEY=
# URL Neon com sslmode=require (ou verify-full); o app seleciona psycopg 3.
DATABASE_URL=
TRUST_PROXY=true
TRUSTED_HOSTS=
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_SINGLE_PROCESS=true
RATELIMIT_KEY_PREFIX=bolao2-production
# Free suspende o processo ocioso. Prefira sincronização manual.
SYNC_ENABLED=false
SYNC_INTERVALO_SEGUNDOS=900
FOOTBALL_DATA_TOKEN=
MAINTENANCE_MODE=false
# Não configurar REDIS_URL ou PERSISTENT_DATA_DIR nesta arquitetura.
