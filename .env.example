# ── Configurações do Bolão v2 ──────────────────────────────────────────────
# Copie este arquivo para .env e ajuste as variáveis conforme necessário.

# Chave secreta para sessões Flask (gerar com: python -c "import secrets; print(secrets.token_hex(32))")
# Em PRODUÇÃO, esta variável é OBRIGATÓRIA e deve ser uma chave forte.
SECRET_KEY=dev-inseguro-troque-em-producao

# Banco local; produção gratuita usa PostgreSQL Neon (DEPLOY.md).
DATABASE_URL=sqlite:///banco.db

# Token da API football-data.org (obtenha em https://www.football-data.org/)
FOOTBALL_DATA_TOKEN=

# Ambiente de execução: development, production, testing
APP_ENV=development


# Debug (0 ou 1) — use 0 em produção
FLASK_DEBUG=0

# Limites locais em desenvolvimento. Render Free também usa memória, com um worker.
RATELIMIT_STORAGE_URI=memory://
# Produção: pip install -r requirements-production.txt
# Render Free: configure RATELIMIT_SINGLE_PROCESS=true e siga DEPLOY.md.
RATELIMIT_KEY_PREFIX=bolao2-development
